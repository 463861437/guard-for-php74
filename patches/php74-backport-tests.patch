--- /dev/null
+++ b/ext/session/tests/phpguard_upload_progress_disabled.phpt
@@ -0,0 +1,52 @@
+--TEST--
+PHP Guard: the EOL security backport disables session upload progress without blocking file uploads
+--INI--
+file_uploads=1
+upload_max_filesize=1M
+post_max_size=2M
+session.save_path=
+session.name=PHPSESSID
+session.use_cookies=1
+session.use_only_cookies=1
+session.use_strict_mode=0
+session.upload_progress.enabled=1
+session.upload_progress.cleanup=0
+session.upload_progress.prefix=upload_progress_
+session.upload_progress.name=PHP_SESSION_UPLOAD_PROGRESS
+session.upload_progress.freq=0
+session.save_handler=files
+--SKIPIF--
+<?php if (!extension_loaded('session')) die('skip session extension unavailable'); ?>
+--COOKIE--
+PHPSESSID=phpguard-upload-progress-regression
+--POST_RAW--
+Content-Type: multipart/form-data; boundary=phpguard-fixed-boundary
+--phpguard-fixed-boundary
+Content-Disposition: form-data; name="PHP_SESSION_UPLOAD_PROGRESS"
+
+proof
+--phpguard-fixed-boundary
+Content-Disposition: form-data; name="upload"; filename="proof.txt"
+Content-Type: text/plain
+
+payload
+--phpguard-fixed-boundary--
+--FILE--
+<?php
+var_dump(session_start());
+var_dump(ini_get('session.upload_progress.enabled') === '1');
+var_dump(ini_get('session.upload_progress.cleanup') === '0');
+var_dump($_FILES['upload']['error'] === UPLOAD_ERR_OK);
+var_dump($_FILES['upload']['size'] === 7);
+var_dump(file_get_contents($_FILES['upload']['tmp_name']) === 'payload');
+var_dump(isset($_SESSION['upload_progress_proof']));
+session_destroy();
+?>
+--EXPECT--
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+bool(false)
